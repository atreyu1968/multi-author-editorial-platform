# Multi-Author Editorial Platform - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=production
PORT=5000

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Individual database connection parameters (used by some tools)
PGHOST=localhost
PGPORT=5432
PGUSER=your_database_user
PGPASSWORD=your_database_password
PGDATABASE=your_database_name

# ============================================================================
# Session Configuration
# ============================================================================
# Generate a random secret with: openssl rand -hex 32
SESSION_SECRET=your-random-session-secret-here

# ============================================================================
# PayPal Configuration
# ============================================================================
# Get these from https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Use 'sandbox' for testing, 'production' for live payments
PAYPAL_MODE=sandbox

# ============================================================================
# Object Storage Configuration (Optional)
# ============================================================================
# For file uploads (author logos, book covers, digital files)
# If using Google Cloud Storage or similar:
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket-id/public
PRIVATE_OBJECT_DIR=/your-bucket-id/.private

# ============================================================================
# Internationalization
# ============================================================================
# Default language for the platform
# Options: es-ES, en-US, ca-ES, fr-FR, it-IT, de-DE, pt-PT
DEFAULT_LOCALE=es-ES

# ============================================================================
# Email Configuration (Optional)
# ============================================================================
# For sending order confirmations, newsletters, etc.
# EMAIL_API_KEY=your-email-service-api-key
# EMAIL_PROVIDER=resend

# Supported email providers:
# - resend
# - sendgrid
# - mailchimp_transactional
# - brevo
# - postmark
# - mailgun

# ============================================================================
# Additional Configuration
# ============================================================================

# Base URL of your application (for email links, etc.)
# BASE_URL=https://yourdomain.com

# Enable debug mode (optional)
# DEBUG=false
